# FoodieFinder AI - Environment Variables (server-side only)

# Groq API Key (FREE - Get from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Upstream restaurant data host used by the /api proxy functions
DATA_PROVIDER_HOST=https://www.swiggy.com

# Instructions:
# 1. Copy this file and rename it to `.env`
# 2. Get your FREE Groq API key from: https://console.groq.com/keys
# 3. Replace 'your_groq_api_key_here' with your actual key
# 4. Restart the development server

# Example:
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
